# Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
NIO_PORT=8787
LOG_LEVEL=info
NIO_RATE_LIMIT_PER_MINUTE=300
# Write memory/session exports to /data every N seconds (0 disables).
NIO_EXPORT_INTERVAL_SECONDS=300

# Only needed when running the server outside Docker:
# DATABASE_URL=postgres://nio:change-me@127.0.0.1:5432/nio
# NIO_DATA_DIR=./data
# NIO_WEB_DIR=../web/dist
